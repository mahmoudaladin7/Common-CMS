# Run npm run setup to create .env with a unique secret. Never commit .env.
PAYLOAD_SECRET=
SERVER_URL=http://localhost:3000
DATABASE_URL=file:./cms.db
# Absolute directory recommended for production. Mount a persistent volume.
MEDIA_DIR=./media

# Optional SMTP: password reset email requires a real mail provider.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=cms@example.com
# SMTP_FROM_NAME=Common CMS

# Comma-separated browser origins allowed to read the API, if separate from CMS.
# CORS_ORIGINS=https://www.example.com
# Explicit opt-in to local schema synchronization in development only.
# Production always uses committed migrations.
